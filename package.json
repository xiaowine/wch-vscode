{
  "name": "wch-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.3",
  "publisher": "winerealms",
  "packageManager": "pnpm@11.1.0",
  "license": "GPL-3.0-only",
  "icon": "media/wch-vscode-sidebar.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaowine/wch-vscode"
  },
  "homepage": "https://github.com/xiaowine/wch-vscode",
  "bugs": {
    "url": "https://github.com/xiaowine/wch-vscode/issues"
  },
  "keywords": [
    "wch",
    "mounriver",
    "risc-v",
    "embedded",
    "debug"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wchVscode.refreshProjects",
        "title": "%command.refreshProjects%",
        "category": "WCH",
        "icon": {
          "light": "media/refresh.svg",
          "dark": "media/refresh.svg"
        }
      },
      {
        "command": "wchVscode.buildProject",
        "title": "%command.build%",
        "category": "WCH"
      },
      {
        "command": "wchVscode.cleanProject",
        "title": "%command.clean%",
        "category": "WCH"
      },
      {
        "command": "wchVscode.cleanBuildProject",
        "title": "%command.cleanBuild%",
        "category": "WCH"
      },
      {
        "command": "wchVscode.downloadProject",
        "title": "%command.download%",
        "category": "WCH"
      },
      {
        "command": "wchVscode.buildDownloadProject",
        "title": "%command.buildDownload%",
        "category": "WCH"
      },
      {
        "command": "wchVscode.debugProject",
        "title": "%command.debug%",
        "category": "WCH"
      },
      {
        "command": "wchVscode.openInMounRiverStudio",
        "title": "%command.openInMrs2%",
        "category": "WCH"
      }
    ],
    "debuggers": [
      {
        "type": "wch-riscv",
        "label": "%debugger.wchRiscv%",
        "program": "./out/debug/wchRiscvDebugAdapter.js",
        "runtime": "node",
        "languages": [
          "c",
          "cpp",
          "asm"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wchVscodeSidebar",
          "title": "%viewContainer.title%",
          "icon": "media/wch-vscode-sidebar.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "wchVscodeProjectFilesView",
          "name": "%view.projectFiles%"
        }
      ],
      "wchVscodeSidebar": [
        {
          "id": "wchVscodeSidebarView",
          "name": "%view.overview%"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "wchVscode.mounRiverStudioPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.mounRiverStudioPath.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "wchVscode.debugProject",
        "key": "f5"
      },
      {
        "command": "wchVscode.buildProject",
        "key": "f7"
      },
      {
        "command": "wchVscode.cleanBuildProject",
        "key": "shift+f7"
      },
      {
        "command": "wchVscode.downloadProject",
        "key": "f8"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wchVscode.refreshProjects",
          "when": "view == wchVscodeSidebarView",
          "group": "navigation"
        },
        {
          "command": "wchVscode.refreshProjects",
          "when": "view == wchVscodeProjectFilesView",
          "group": "navigation"
        }
      ]
    }
  },
  "vsce": {
    "dependencies": false,
    "yarn": false
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "vscode:prepublish": "pnpm run clean && pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pnpm dlx @vscode/vsce package --no-dependencies",
    "publish": "pnpm dlx @vscode/vsce publish --no-dependencies",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "fast-xml-parser": "^5.7.2"
  }
}
